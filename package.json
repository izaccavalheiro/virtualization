{
  "name": "simple-virtualization",
  "version": "1.0.16",
  "description": "Virtualization for React",
  "keywords": [
    "react",
    "viewport",
    "list",
    "windowing",
    "window",
    "virtualization",
    "virtual",
    "virtualized",
    "grid",
    "table"
  ],
  "homepage": "https://github.com/izaccavalheiro/virtualization",
  "bugs": {
    "url": "https://github.com/izaccavalheiro/virtualization/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/izaccavalheiro/virtualization.git"
  },
  "license": "MIT",
  "author": {
    "name": "Izac Cavalheiro",
    "email": "izac@izaccavalheiro.com",
    "url": "https://github.com/izaccavalheiro/virtualization"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/virtualization.umd.cjs",
  "module": "./dist/virtualization.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/virtualization.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/virtualization.umd.cjs"
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "preexample": "cd example && npm i",
    "example": "cd example && npm run dev",
    "lint": "eslint . --max-warnings=12",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint:package": "publint --strict && attw --pack .",
    "test:smoke": "node scripts/smoke-test.js",
    "size-check": "npm run build && node scripts/size-check.js",
    "check:dist": "git diff --exit-code --stat -- dist",
    "validate": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && node scripts/size-check.js && npm run lint:package",
    "prepublishOnly": "npm run validate"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "gzip-size": "^7.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "publint": "^0.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "terser": "^5.39.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^3.0.0"
  }
}

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npm run size-check)",
      "Bash(npm run validate)",
      "Bash(npx jest:*)",
      "Bash(npx eslint:*)",
      "Bash(npx tsc:*)"
    ],
    "deny": [
      "Bash(npm publish:*)",
      "Bash(npm version:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)"
    ]
  }
}
